              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?author=George Orwell",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ],
              "query": [
                {
                  "key": "author",
                  "value": "George Orwell"
                }
              ]
            }
          }
        },
        {
          "name": "Get books paginated",
